# =============================================================================
# CITRA Viva environment variables
# Copy this file to .env and fill in the values. Never commit .env.
# Nothing below is ever hardcoded in the source.
# =============================================================================

# --- Google Cloud / Gemini Enterprise Agent Platform (formerly Vertex AI) ----
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Use `global` unless you have a reason not to. Recent Gemini models are served
# from the global endpoint first, and a regional value such as us-central1 will
# fail with a 404 NOT_FOUND for a model that is not yet regionalized.
GOOGLE_CLOUD_LOCATION=global

# Local auth: run `gcloud auth application-default login` and leave the variable
# below empty. Set it only when using a service account key file. On Cloud Run
# and Agent Runtime, leave it empty and use the built-in service identity.
GOOGLE_APPLICATION_CREDENTIALS=

# Route google-genai to Agent Platform instead of the Gemini Developer API.
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Model ------------------------------------------------------------------
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=16384

# Transient failures (quota exhaustion, service unavailable) are retried with
# exponential backoff. A mid-session 429 must not end a defense.
GEMINI_MAX_RETRIES=4
GEMINI_RETRY_BASE_DELAY=2.0

# --- Voice ------------------------------------------------------------------
# Speech is a layer over the text loop, never a replacement for it: a spoken
# answer becomes text, is shown to the student to correct, and then travels the
# same endpoint a typed answer does, so every session rule still applies to it.
# That is why these are two ordinary models rather than a live audio session.
GEMINI_SPEECH_MODEL=gemini-3.5-flash
GEMINI_VOICE_MODEL=gemini-2.5-flash-tts
GEMINI_VOICE_NAME=Charon

# Streaming transcription. The Live model is refused on the global endpoint and
# answers in us-central1, so it carries its own location.
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
GEMINI_LIVE_LOCATION=us-central1

# Origins allowed to open the streaming socket, comma separated. The browser
# reaches this endpoint directly because a Next.js route handler cannot carry a
# WebSocket upgrade. Empty by default, so a local run stays closed until it says
# otherwise. Every connection still verifies the caller's token.
ALLOWED_WEB_ORIGINS=http://localhost:3100

# --- Firestore --------------------------------------------------------------
# "(default)" is the built-in Firestore native mode database name. Everything
# is stored here: sessions, the submitted manuscript, and the weakness profile
# carried between sessions. The uploaded file itself is never written anywhere.
FIRESTORE_DATABASE=(default)

# --- Authentication ---------------------------------------------------------
# Firebase ID tokens are verified against Google's public keys, and a session
# can only be read by the account that created it.
#
# Leave this false to run locally without a Firebase project. Turn it on in any
# deployment: with it off, a session id is the only thing standing between a
# stranger and someone's manuscript.
AUTH_REQUIRED=false
# Defaults to GOOGLE_CLOUD_PROJECT when empty.
FIREBASE_PROJECT_ID=

# --- Application ------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# --- Observability (OpenTelemetry to Cloud Trace) ---------------------------
# One span per agent call, nested under the request that caused it, so a single
# turn of a defense reads as one trace. Off here: a local run exports nothing
# and needs no credentials for it. Turning it on requires cloudtrace and
# telemetry APIs enabled and roles/cloudtrace.agent on the running identity.
#
# Nothing that fails here can cost a student a turn. A missing package, a
# missing project, or an exporter that cannot reach Google all end the same
# way: no spans, one warning, and a defense that carries on.
ENABLE_CLOUD_TRACE=false
