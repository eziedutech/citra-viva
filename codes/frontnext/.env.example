# Base URL of the CITRA Viva FastAPI service.
# The browser never sees this: every call goes through a Next route handler,
# so the API can stay private and there is no CORS to configure.
CITRA_API_BASE_URL=https://citra-viva-api-40911677848.asia-southeast2.run.app

# --- Firebase (sign-in) ------------------------------------------------------
# Deliberately not NEXT_PUBLIC_: those are frozen into the bundle at build time,
# and Cloud Run supplies environment variables to the running container. They
# are read on the server and handed to the client, so the values are correct in
# every environment rather than only on a developer machine.
#
# None of these is a secret. A Firebase web API key identifies the project; it
# authorises nothing on its own, which is why the backend verifies ID tokens
# instead of relying on this being hidden.
#
# Fetch them with:
#   gcloud auth print-access-token
#   curl -H "Authorization: Bearer TOKEN" -H "x-goog-user-project: PROJECT_ID" \
#     "https://firebase.googleapis.com/v1beta1/projects/PROJECT_ID/webApps/APP_ID/config"
#
# Leave them empty to run without sign-in.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
